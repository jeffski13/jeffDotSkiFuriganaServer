# Loaded automatically when NODE_ENV is not "production" (i.e. running locally).
# When USE_FIREBASE is false, /lyricsQR reads and writes its redirect URL and
# updateKey from the local lyricsQR.local.json file instead of Firebase, so it
# still works without internet access. The file is created automatically on
# first use with a random updateKey and the default practiceLyrics URL.
USE_FIREBASE=false

# Required when USE_FIREBASE is true and you're authenticating locally with
# `gcloud auth application-default login` (user credentials don't carry a
# project id the way a service account key does).
GOOGLE_CLOUD_PROJECT=jeffdotski
